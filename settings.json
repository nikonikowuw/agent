{
  "lastChangelogVersion": "0.83.0",
  "theme": "codex",
  "quietStartup": true,
  "defaultProvider": "cliproxy",
  "defaultModel": "deepseek-v4-flash",
  "defaultThinkingLevel": "max",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "packages": [
    "npm:context-mode",
    "npm:pi-web-access",
    "npm:@ff-labs/pi-fff",
    "npm:pi-wtf",
    "npm:@hypabolic/pi-hypa",
    "npm:pi-model-manager",
    "npm:pi-subagents"
  ],
  "retry": {
    "enabled": true,
    "maxRetries": 10,
    "baseDelayMs": 2000,
    "provider": {
      "timeoutMs": 360000,
      "maxRetries": 0,
      "maxRetryDelayMs": 30000
    }
  },
  "hideThinkingBlock": true,
  "showHardwareCursor": false,
  "autocompleteMaxVisible": 5,
  "enableInstallTelemetry": true,
  "defaultProjectTrust": "always",
  "steeringMode": "one-at-a-time",
  "treeFilterMode": "all",
  "editorPaddingX": 0,
  "outputPad": 0
}
